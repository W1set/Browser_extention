{
  "manifest_version": 3,
  "name": "Site Verdict — site safety checker",
  "version": "1.1.0",
  "description": "Checks website reputation using VirusTotal and Google Safe Browsing, plus domain-age and anti-phishing heuristics.",
  "browser_specific_settings": {
    "gecko": {
      "id": "site-verdict@local.extension",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "tabs",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://rdap.org/*",
    "https://www.virustotal.com/*",
    "https://safebrowsing.googleapis.com/*"
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_title": "Site Verdict",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
